# HADJ Dialysis Intelligence — configuration serveur.
# Copiez en .env (chargé par votre gestionnaire de process : systemd, pm2, docker…)
# ou exportez ces variables dans l'environnement.

# --- Réseau ---
PORT=4310
# Liste blanche CORS en production (séparées par des virgules). Absent = ouvert.
# HADJ_CORS_ORIGINS=https://hadj.mon-hopital.fr

# --- Secrets (PRODUCTION : depuis un coffre-fort / KMS, jamais en clair sur disque) ---
# Secret de signature JWT — ≥ 32 octets aléatoires. Sinon auto-généré dans .jwt-secret.
# HADJ_JWT_SECRET=
# Durée de vie des jetons (secondes).
HADJ_TOKEN_TTL=28800
# Clé maître du coffre-fort de secrets applicatif (clé Gemini…). Sinon .secret-key.
# HADJ_SECRET_KEY=

# --- Base & données ---
HADJ_DB=./hadj.db
HADJ_USERS=./users.seed.json

# --- Connecteurs (Phase 3) ---
HADJ_CONNECTORS=./connectors/connectors.config.json
HADJ_TICK_MS=2000

# --- TLS ---
# Répertoire des certificats (key.pem + cert.pem). Sinon HTTP en clair.
HADJ_CERT_DIR=./certs

# --- Anti-bruteforce (POC) ---
HADJ_LOGIN_MAX_FAILS=12
HADJ_LOGIN_LOCK_MS=30000

# --- IA (optionnel) ---
# GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
